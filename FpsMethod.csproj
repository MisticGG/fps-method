<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net8.0</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <AssemblyName>FpsMethod</AssemblyName>
    <RootNamespace>FpsMethod</RootNamespace>
    <BuiltInComInteropSupport>true</BuiltInComInteropSupport>
  </PropertyGroup>

  <PropertyGroup Condition="'$(Configuration)'=='Release'">
    <DebugType>none</DebugType>
    <DebugSymbols>false</DebugSymbols>
    <IncludeNativeLibrariesForSelfExtract>true</IncludeNativeLibrariesForSelfExtract>
    <!-- Trim unused BCL code (~50-70 MB saving) -->
    <PublishTrimmed>true</PublishTrimmed>
    <!-- Compress the single-file bundle (~15-20% further reduction) -->
    <EnableCompressionInSingleFile>true</EnableCompressionInSingleFile>
    <!-- All trim warnings originate inside Avalonia's own assemblies, not our code -->
    <SuppressTrimAnalysisWarnings>true</SuppressTrimAnalysisWarnings>
  </PropertyGroup>
  <ItemGroup>
    <PackageReference Include="Avalonia"              Version="11.1.0" />
    <PackageReference Include="Avalonia.Desktop"      Version="11.1.0" />
    <PackageReference Include="Avalonia.Themes.Fluent" Version="11.1.0" />
    <!-- Avalonia.Fonts.Inter removed: the app uses Segoe UI, not Inter -->
  </ItemGroup>
</Project>
