<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        x:Class="FpsMethod.MainWindow"
        Title="FPS Method"
        Width="1120"
        Height="740"
        SystemDecorations="None"
        CanResize="False"
        TransparencyLevelHint="AcrylicBlur"
        Background="Transparent"
        FontFamily="Segoe UI"
        Foreground="#D0D0D0"
        WindowStartupLocation="CenterScreen">

    <Window.Styles>

        <Style Selector="TextBlock.section-label">
            <Setter Property="FontSize"          Value="8.5"/>
            <Setter Property="FontWeight"        Value="Bold"/>
            <Setter Property="Foreground"        Value="#686868"/>
            <Setter Property="Margin"            Value="0,0,0,8"/>
        </Style>

        <Style Selector="TextBlock.stat-label">
            <Setter Property="FontSize"            Value="8.5"/>
            <Setter Property="FontWeight"          Value="Bold"/>
            <Setter Property="Foreground"          Value="#585858"/>
            <Setter Property="HorizontalAlignment" Value="Center"/>
            <Setter Property="Margin"              Value="0,0,0,5"/>
        </Style>

        <Style Selector="TextBlock.stat-value">
            <Setter Property="FontSize"            Value="16"/>
            <Setter Property="FontWeight"          Value="Light"/>
            <Setter Property="Foreground"          Value="#929292"/>
            <Setter Property="HorizontalAlignment" Value="Center"/>
        </Style>

        <Style Selector="Border.panel">
            <Setter Property="Background"      Value="#C20F0F0F"/>
            <Setter Property="BorderBrush"     Value="#1B1B1B"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="CornerRadius"    Value="12"/>
        </Style>

        <Style Selector="Border.inner-surface">
            <Setter Property="Background"      Value="#CC0B0B0B"/>
            <Setter Property="BorderBrush"     Value="#181818"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="CornerRadius"    Value="10"/>
        </Style>

        <Style Selector="Border.stat-card">
            <Setter Property="Background"      Value="#BD090909"/>
            <Setter Property="BorderBrush"     Value="#161616"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="CornerRadius"    Value="10"/>
            <Setter Property="Padding"         Value="0,13"/>
        </Style>

        <Style Selector="Button.chrome-btn">
            <Setter Property="Background"      Value="Transparent"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="Width"           Value="36"/>
            <Setter Property="Height"          Value="36"/>
            <Setter Property="Cursor"          Value="Hand"/>
            <Setter Property="Focusable"       Value="False"/>
            <Setter Property="Padding"         Value="0"/>
            <Setter Property="Template">
                <ControlTemplate>
                    <Border Name="Bd" Background="{TemplateBinding Background}" CornerRadius="7">
                        <ContentPresenter Content="{TemplateBinding Content}"
                                          HorizontalContentAlignment="Center"
                                          VerticalContentAlignment="Center"/>
                    </Border>
                </ControlTemplate>
            </Setter>
        </Style>
        <Style Selector="Button.chrome-btn:pointerover /template/ Border#Bd">
            <Setter Property="Background" Value="#1A1A1A"/>
        </Style>
        <Style Selector="Button.chrome-btn:pressed /template/ Border#Bd">
            <Setter Property="Background" Value="#242424"/>
        </Style>

        <Style Selector="Button.close-btn">
            <Setter Property="Background"      Value="Transparent"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="Width"           Value="36"/>
            <Setter Property="Height"          Value="36"/>
            <Setter Property="Cursor"          Value="Hand"/>
            <Setter Property="Focusable"       Value="False"/>
            <Setter Property="Padding"         Value="0"/>
            <Setter Property="Template">
                <ControlTemplate>
                    <Border Name="Bd" Background="{TemplateBinding Background}" CornerRadius="7">
                        <ContentPresenter Content="{TemplateBinding Content}"
                                          HorizontalContentAlignment="Center"
                                          VerticalContentAlignment="Center"/>
                    </Border>
                </ControlTemplate>
            </Setter>
        </Style>
        <Style Selector="Button.close-btn:pointerover /template/ Border#Bd">
            <Setter Property="Background" Value="#420000"/>
        </Style>
        <Style Selector="Button.close-btn:pressed /template/ Border#Bd">
            <Setter Property="Background" Value="#2D0000"/>
        </Style>

        <Style Selector="Button.action-btn">
            <Setter Property="Background"          Value="Transparent"/>
            <Setter Property="BorderThickness"     Value="1"/>
            <Setter Property="FontFamily"          Value="Segoe UI"/>
            <Setter Property="FontSize"            Value="11.5"/>
            <Setter Property="FontWeight"          Value="SemiBold"/>
            <Setter Property="Cursor"              Value="Hand"/>
            <Setter Property="Padding"             Value="0"/>
            <Setter Property="HorizontalAlignment" Value="Stretch"/>
            <Setter Property="VerticalAlignment"   Value="Stretch"/>
            <Setter Property="Template">
                <ControlTemplate>
                    <Border Name="Bd"
                            Background="{TemplateBinding Background}"
                            BorderBrush="{TemplateBinding BorderBrush}"
                            BorderThickness="{TemplateBinding BorderThickness}"
                            CornerRadius="10">
                        <ContentPresenter Content="{TemplateBinding Content}"
                                          HorizontalContentAlignment="Center"
                                          VerticalContentAlignment="Center"/>
                    </Border>
                </ControlTemplate>
            </Setter>
        </Style>
        <Style Selector="Button.action-btn:pointerover /template/ Border#Bd">
            <Setter Property="Background" Value="#10FFFFFF"/>
        </Style>
        <Style Selector="Button.action-btn:pressed /template/ Border#Bd">
            <Setter Property="Background" Value="#20FFFFFF"/>
        </Style>

        <Style Selector="Button.preset-btn">
            <Setter Property="Background"          Value="#0C0C0C"/>
            <Setter Property="BorderBrush"         Value="#1E1E1E"/>
            <Setter Property="BorderThickness"     Value="1"/>
            <Setter Property="Padding"             Value="0"/>
            <Setter Property="Cursor"              Value="Hand"/>
            <Setter Property="HorizontalAlignment" Value="Stretch"/>
            <Setter Property="VerticalAlignment"   Value="Stretch"/>
            <Setter Property="Focusable"           Value="False"/>
            <Setter Property="Template">
                <ControlTemplate>
                    <Border Name="Bd"
                            Background="{TemplateBinding Background}"
                            BorderBrush="{TemplateBinding BorderBrush}"
                            BorderThickness="{TemplateBinding BorderThickness}"
                            CornerRadius="8">
                        <ContentPresenter Content="{TemplateBinding Content}"
                                          HorizontalContentAlignment="Center"
                                          VerticalContentAlignment="Center"/>
                    </Border>
                </ControlTemplate>
            </Setter>
        </Style>
        <Style Selector="Button.preset-btn:pointerover /template/ Border#Bd">
            <Setter Property="Background" Value="#141414"/>
        </Style>
        <Style Selector="Button.preset-btn:pressed /template/ Border#Bd">
            <Setter Property="Background" Value="#1C1C1C"/>
        </Style>

        <Style Selector="TextBox.dark-input">
            <Setter Property="Background"       Value="#0D0D0D"/>
            <Setter Property="Foreground"       Value="#909090"/>
            <Setter Property="FontSize"         Value="11"/>
            <Setter Property="Height"           Value="30"/>
            <Setter Property="Padding"          Value="8,5"/>
            <Setter Property="CaretBrush"       Value="#888888"/>
            <Setter Property="BorderBrush"      Value="#222222"/>
            <Setter Property="BorderThickness"  Value="1"/>
            <Setter Property="CornerRadius"     Value="7"/>
        </Style>
        <Style Selector="TextBox.dark-input:focus /template/ Border#PART_BorderElement">
            <Setter Property="BorderBrush" Value="#363636"/>
        </Style>
        <Style Selector="TextBox.dark-input:pointerover /template/ Border#PART_BorderElement">
            <Setter Property="BorderBrush" Value="#2A2A2A"/>
        </Style>

    </Window.Styles>

    <Grid>

        <ExperimentalAcrylicBorder IsHitTestVisible="False" CornerRadius="14">
            <ExperimentalAcrylicBorder.Material>
                <ExperimentalAcrylicMaterial BackgroundSource="Digger"
                                             TintColor="Black"
                                             TintOpacity="1"
                                             MaterialOpacity="0.65"/>
            </ExperimentalAcrylicBorder.Material>
        </ExperimentalAcrylicBorder>

        <Border CornerRadius="14" BorderThickness="1" BorderBrush="#181818" Background="#94000000">
            <Grid>
                <Grid.RowDefinitions>
                    <RowDefinition Height="48"/>
                    <RowDefinition Height="*"/>
                    <RowDefinition Height="28"/>
                </Grid.RowDefinitions>

                <Grid Grid.Row="0" Background="Transparent" PointerPressed="TitleBar_PointerPressed">
                    <Grid Margin="14,0,10,0">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto"/>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="Auto"/>
                        </Grid.ColumnDefinitions>

                        <Rectangle Grid.ColumnSpan="3" Height="1" VerticalAlignment="Bottom"
                                   Fill="#131313" IsHitTestVisible="False"/>

                        <StackPanel Grid.Column="0" Orientation="Horizontal" VerticalAlignment="Center">
                            <Grid Width="26" Height="26" Margin="0,0,10,0">
                                <Ellipse Width="220" Height="220" Opacity="0.055" IsHitTestVisible="False">
                                    <Ellipse.Fill>
                                        <RadialGradientBrush>
                                            <GradientStop Color="#FFFFFF" Offset="0"/>
                                            <GradientStop Color="Transparent" Offset="1"/>
                                        </RadialGradientBrush>
                                    </Ellipse.Fill>
                                </Ellipse>
                                <Border Width="26" Height="26" CornerRadius="7"
                                        Background="#111111" BorderBrush="#272727" BorderThickness="1">
                                    <TextBlock Text="▶" FontSize="10" Foreground="#9A9A9A"
                                               HorizontalAlignment="Center" VerticalAlignment="Center"
                                               Margin="1,0,0,0"/>
                                </Border>
                            </Grid>
                            <StackPanel VerticalAlignment="Center">
                                <TextBlock Text="FPS Method" FontSize="13" FontWeight="SemiBold"
                                           Foreground="#C8C8C8" Margin="0,0,0,1"/>
                                <TextBlock Text="TikTok no-compression patcher" FontSize="9" Foreground="#3A3A3A"/>
                            </StackPanel>
                        </StackPanel>

                        <Border Grid.Column="1"
                                HorizontalAlignment="Center" VerticalAlignment="Center"
                                CornerRadius="6" Padding="11,5"
                                Background="#0D0D0D" BorderBrush="#1F1F1F" BorderThickness="1">
                            <StackPanel Orientation="Horizontal">
                                <Ellipse Width="5" Height="5" Fill="#D0D0D0"
                                         VerticalAlignment="Center" Margin="0,0,7,0">
                                    <Ellipse.Effect>
                                        <DropShadowEffect Color="#AAAAAA" BlurRadius="5" OffsetX="0" OffsetY="0" Opacity="0.7"/>
                                    </Ellipse.Effect>
                                </Ellipse>
                                <TextBlock Text="EDIT LIST PATCH ACTIVE" FontSize="8.5" FontWeight="Bold"
                                           Foreground="#4D4D4D" VerticalAlignment="Center"/>
                            </StackPanel>
                        </Border>

                        <StackPanel Grid.Column="2" Orientation="Horizontal" VerticalAlignment="Center">
                            <Button Classes="chrome-btn" Click="MinBtn_Click">
                                <TextBlock Text="—" FontSize="12" Foreground="#585858"/>
                            </Button>
                            <Button Classes="close-btn" Click="CloseBtn_Click" Margin="3,0,0,0">
                                <TextBlock Text="✕" FontSize="11" Foreground="#585858"/>
                            </Button>
                        </StackPanel>

                    </Grid>
                </Grid>

                <Grid Grid.Row="1" Margin="14,10,14,8">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="360"/>
                        <ColumnDefinition Width="12"/>
                        <ColumnDefinition Width="*"/>
                    </Grid.ColumnDefinitions>

                    <Border Grid.Column="0" Classes="panel">
                        <Grid Margin="18,16,18,16">
                            <Grid.RowDefinitions>
                                <RowDefinition Height="Auto"/>
                                <RowDefinition Height="*"/>
                                <RowDefinition Height="14"/>
                                <RowDefinition Height="Auto"/>
                                <RowDefinition Height="Auto"/>
                                <RowDefinition Height="14"/>
                                <RowDefinition Height="Auto"/>
                                <RowDefinition Height="Auto"/>
                                <RowDefinition Height="14"/>
                                <RowDefinition Height="Auto"/>
                                <RowDefinition Height="48"/>
                                <RowDefinition Height="Auto"/>
                            </Grid.RowDefinitions>

                            <TextBlock Grid.Row="0" Text="SOURCE FILE" Classes="section-label"/>

                            <Border Grid.Row="1"
                                    x:Name="DropZoneBorder"
                                    Classes="inner-surface"
                                    Cursor="Hand"
                                    DragDrop.AllowDrop="True"
                                    PointerPressed="DropZone_PointerPressed"
                                    MinHeight="100">
                                <StackPanel VerticalAlignment="Center" HorizontalAlignment="Center" Margin="20,16">
                                    <Border Width="54" Height="54" CornerRadius="27"
                                            HorizontalAlignment="Center" Margin="0,0,0,14"
                                            Background="#090909" BorderBrush="#242424" BorderThickness="1">
                                        <Viewbox Width="20" Height="20"
                                                 HorizontalAlignment="Center" VerticalAlignment="Center">
                                            <Canvas Width="24" Height="24">
                                                <Path Stroke="#4A4A4A"
                                                      StrokeThickness="1.7"
                                                      StrokeJoin="Round"
                                                      StrokeLineCap="Round"
                                                      Data="M12,19 L12,7 M7,11.5 L12,6.5 L17,11.5 M5,20.5 L19,20.5"/>
                                            </Canvas>
                                        </Viewbox>
                                    </Border>
                                    <TextBlock x:Name="DropLabel"
                                               Text="Drop MP4 here"
                                               FontSize="12.5" FontWeight="SemiBold"
                                               Foreground="#808080"
                                               HorizontalAlignment="Center"
                                               Margin="0,0,0,4"/>
                                    <TextBlock x:Name="DropSubLabel"
                                               Text="or click to browse"
                                               FontSize="9.5" Foreground="#505050"
                                               HorizontalAlignment="Center"/>
                                </StackPanel>
                            </Border>

                            <TextBlock Grid.Row="3" Text="VIDEO INFO" Classes="section-label"/>

                            <Grid Grid.Row="4">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="8"/>
                                    <ColumnDefinition Width="*"/>
                                </Grid.ColumnDefinitions>
                                <Grid.RowDefinitions>
                                    <RowDefinition Height="*"/>
                                    <RowDefinition Height="8"/>
                                    <RowDefinition Height="*"/>
                                </Grid.RowDefinitions>

                                <Border Grid.Row="0" Grid.Column="0" Classes="stat-card">
                                    <StackPanel>
                                        <TextBlock Text="RESOLUTION" Classes="stat-label"/>
                                        <TextBlock x:Name="StatRes" Text="—" Classes="stat-value"/>
                                    </StackPanel>
                                </Border>
                                <Border Grid.Row="0" Grid.Column="2" Classes="stat-card">
                                    <StackPanel>
                                        <TextBlock Text="FPS" Classes="stat-label"/>
                                        <TextBlock x:Name="StatFps" Text="—" Classes="stat-value"/>
                                    </StackPanel>
                                </Border>
                                <Border Grid.Row="2" Grid.Column="0" Classes="stat-card">
                                    <StackPanel>
                                        <TextBlock Text="BITRATE" Classes="stat-label"/>
                                        <TextBlock x:Name="StatBr" Text="—" Classes="stat-value"/>
                                    </StackPanel>
                                </Border>
                                <Border Grid.Row="2" Grid.Column="2" Classes="stat-card">
                                    <StackPanel>
                                        <TextBlock Text="FILE SIZE" Classes="stat-label"/>
                                        <TextBlock x:Name="StatMb" Text="—" Classes="stat-value"/>
                                    </StackPanel>
                                </Border>
                            </Grid>

                            <TextBlock Grid.Row="6" Text="ACTIVE PATCH" Classes="section-label"/>

                            <Border Grid.Row="7" CornerRadius="10" BorderThickness="1" Padding="14,11"
                                    Background="#0D0D0D" BorderBrush="#222222">
                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*"/>
                                        <ColumnDefinition Width="Auto"/>
                                    </Grid.ColumnDefinitions>
                                    <StackPanel Grid.Column="0">
                                        <StackPanel Orientation="Horizontal" Margin="0,0,0,5">
                                            <Ellipse Width="6" Height="6" Fill="#AAAAAA"
                                                     VerticalAlignment="Center" Margin="0,0,8,0">
                                                <Ellipse.Effect>
                                                    <DropShadowEffect Color="#888888" BlurRadius="5" OffsetX="0" OffsetY="0" Opacity="0.7"/>
                                                </Ellipse.Effect>
                                            </Ellipse>
                                            <TextBlock Text="Edit List Patch"
                                                       FontSize="11" FontWeight="SemiBold"
                                                       Foreground="#747474" VerticalAlignment="Center"/>
                                        </StackPanel>
                                        <TextBlock Text="Corrupts elst timing box with invalid version byte"
                                                   FontSize="9.5" Foreground="#4A4A4A"
                                                   TextWrapping="Wrap" LineHeight="15"/>
                                    </StackPanel>
                                    <Border Grid.Column="1" Padding="7,3" CornerRadius="5"
                                            VerticalAlignment="Top" Margin="10,0,0,0"
                                            Background="#141414" BorderBrush="#252525" BorderThickness="1">
                                        <TextBlock Text="ELST" FontSize="8.5" FontWeight="Bold" Foreground="#585858"/>
                                    </Border>
                                </Grid>
                            </Border>

                            <TextBlock Grid.Row="9" Text="ENCODE SETTINGS" Classes="section-label"/>

                            <!-- Preset buttons: 1080p / 720p / 540p / CUSTOM -->
                            <Grid Grid.Row="10">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="4"/>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="4"/>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="4"/>
                                    <ColumnDefinition Width="*"/>
                                </Grid.ColumnDefinitions>
                                <Button Grid.Column="0" x:Name="Preset0Btn" Classes="preset-btn" Click="PresetBtn_Click">
                                    <StackPanel HorizontalAlignment="Center" Spacing="3">
                                        <TextBlock Text="1080p" FontSize="9.5" FontWeight="Bold" HorizontalAlignment="Center"/>
                                        <TextBlock Text="20 Mbps" FontSize="8" HorizontalAlignment="Center"/>
                                    </StackPanel>
                                </Button>
                                <Button Grid.Column="2" x:Name="Preset1Btn" Classes="preset-btn" Click="PresetBtn_Click">
                                    <StackPanel HorizontalAlignment="Center" Spacing="3">
                                        <TextBlock Text="720p" FontSize="9.5" FontWeight="Bold" HorizontalAlignment="Center"/>
                                        <TextBlock Text="12 Mbps" FontSize="8" HorizontalAlignment="Center"/>
                                    </StackPanel>
                                </Button>
                                <Button Grid.Column="4" x:Name="Preset2Btn" Classes="preset-btn" Click="PresetBtn_Click">
                                    <StackPanel HorizontalAlignment="Center" Spacing="3">
                                        <TextBlock Text="540p" FontSize="9.5" FontWeight="Bold" HorizontalAlignment="Center"/>
                                        <TextBlock Text="7 Mbps" FontSize="8" HorizontalAlignment="Center"/>
                                    </StackPanel>
                                </Button>
                                <Button Grid.Column="6" x:Name="Preset3Btn" Classes="preset-btn" Click="PresetBtn_Click">
                                    <StackPanel HorizontalAlignment="Center" Spacing="3">
                                        <TextBlock Text="CUSTOM" FontSize="9.5" FontWeight="Bold" HorizontalAlignment="Center"/>
                                        <TextBlock Text="manual" FontSize="8" HorizontalAlignment="Center"/>
                                    </StackPanel>
                                </Button>
                            </Grid>

                            <!-- Custom resolution + bitrate inputs (visible only when CUSTOM preset selected) -->
                            <Border Grid.Row="11" x:Name="CustomSettingsPanel" IsVisible="False"
                                    Margin="0,8,0,0" Padding="12,10"
                                    CornerRadius="10" BorderThickness="1"
                                    Background="#0A0A0A" BorderBrush="#1E1E1E">
                                <StackPanel Spacing="10">

                                    <!-- ── Resolution ─────────────────────────── -->
                                    <StackPanel Spacing="6">
                                        <StackPanel Orientation="Horizontal" Spacing="7">
                                            <TextBlock Text="RESOLUTION" FontSize="8.5" FontWeight="Bold" Foreground="#585858"/>
                                            <Border Padding="5,2" CornerRadius="4" VerticalAlignment="Center"
                                                    Background="#0F0F0F" BorderBrush="#1F1F1F" BorderThickness="1">
                                                <TextBlock Text="🔒 ASPECT LOCKED" FontSize="7" FontWeight="Bold" Foreground="#383838"/>
                                            </Border>
                                        </StackPanel>
                                        <Grid>
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="*"/>
                                                <ColumnDefinition Width="Auto"/>
                                                <ColumnDefinition Width="*"/>
                                            </Grid.ColumnDefinitions>
                                            <TextBox Grid.Column="0" x:Name="CustomWidthBox"  Classes="dark-input" Text="1920"
                                                     LostFocus="CustomWidthBox_LostFocus" KeyDown="CustomDim_KeyDown"/>
                                            <TextBlock Grid.Column="1" Text="×" Foreground="#484848"
                                                       VerticalAlignment="Center" Margin="8,0"
                                                       FontSize="14" FontWeight="Light"/>
                                            <TextBox Grid.Column="2" x:Name="CustomHeightBox" Classes="dark-input" Text="1080"
                                                     LostFocus="CustomHeightBox_LostFocus" KeyDown="CustomDim_KeyDown"/>
                                        </Grid>
                                    </StackPanel>

                                    <!-- ── Bitrate + FPS ───────────────────────── -->
                                    <Grid>
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="*"/>
                                            <ColumnDefinition Width="14"/>
                                            <ColumnDefinition Width="*"/>
                                        </Grid.ColumnDefinitions>

                                        <!-- Bitrate -->
                                        <StackPanel Grid.Column="0" Spacing="6">
                                            <TextBlock Text="BITRATE" FontSize="8.5" FontWeight="Bold" Foreground="#585858"/>
                                            <Grid>
                                                <Grid.ColumnDefinitions>
                                                    <ColumnDefinition Width="*"/>
                                                    <ColumnDefinition Width="Auto"/>
                                                </Grid.ColumnDefinitions>
                                                <TextBox Grid.Column="0" x:Name="CustomBitrateBox" Classes="dark-input" Text="20"/>
                                                <TextBlock Grid.Column="1" Text="Mbps" Foreground="#484848"
                                                           VerticalAlignment="Center" Margin="6,0,0,0" FontSize="9"/>
                                            </Grid>
                                        </StackPanel>

                                        <!-- FPS -->
                                        <StackPanel Grid.Column="2" Spacing="6">
                                            <TextBlock Text="FPS" FontSize="8.5" FontWeight="Bold" Foreground="#585858"/>
                                            <Grid>
                                                <Grid.ColumnDefinitions>
                                                    <ColumnDefinition Width="*"/>
                                                    <ColumnDefinition Width="Auto"/>
                                                </Grid.ColumnDefinitions>
                                                <TextBox Grid.Column="0" x:Name="CustomFpsBox" Classes="dark-input" Text="60"/>
                                                <TextBlock Grid.Column="1" Text="fps" Foreground="#484848"
                                                           VerticalAlignment="Center" Margin="6,0,0,0" FontSize="9"/>
                                            </Grid>
                                        </StackPanel>

                                    </Grid>

                                </StackPanel>
                            </Border>

                        </Grid>
                    </Border>

                    <Border Grid.Column="2" Classes="panel">
                        <Grid Margin="18,16,18,16">
                            <Grid.RowDefinitions>
                                <RowDefinition Height="Auto"/>
                                <RowDefinition Height="*"/>
                                <RowDefinition Height="Auto"/>
                                <RowDefinition Height="14"/>
                                <RowDefinition Height="Auto"/>
                                <RowDefinition Height="7"/>
                                <RowDefinition Height="Auto"/>
                                <RowDefinition Height="14"/>
                                <RowDefinition Height="48"/>
                            </Grid.RowDefinitions>

                            <TextBlock Grid.Row="0" Text="ACTIVITY LOG" Classes="section-label"/>

                            <Border Grid.Row="1" Classes="inner-surface">
                                <ScrollViewer x:Name="LogScroll"
                                              VerticalScrollBarVisibility="Auto"
                                              HorizontalScrollBarVisibility="Disabled"
                                              Padding="16,12">
                                    <TextBlock x:Name="LogBlock"
                                               FontSize="10.5"
                                               FontFamily="Cascadia Code, Consolas, monospace"
                                               LineHeight="20"
                                               Foreground="#585858"
                                               TextWrapping="Wrap"/>
                                </ScrollViewer>
                            </Border>

                            <Border Grid.Row="2"
                                    x:Name="WarnBorder"
                                    IsVisible="False"
                                    CornerRadius="9"
                                    BorderThickness="1"
                                    Padding="13,10"
                                    Margin="0,10,0,0">
                                <Border.Background>
                                    <SolidColorBrush Color="#150000" Opacity="0.95"/>
                                </Border.Background>
                                <Border.BorderBrush>
                                    <SolidColorBrush Color="#380000"/>
                                </Border.BorderBrush>
                                <StackPanel Orientation="Horizontal">
                                    <TextBlock Text="⚠" FontSize="12" Foreground="#BB2020"
                                               VerticalAlignment="Top" Margin="0,1,10,0"/>
                                    <TextBlock x:Name="WarnText"
                                               FontSize="10.5" Foreground="#772020"
                                               TextWrapping="Wrap" LineHeight="17"/>
                                </StackPanel>
                            </Border>

                            <Grid Grid.Row="4">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="Auto"/>
                                </Grid.ColumnDefinitions>
                                <TextBlock Grid.Column="0" Text="PROGRESS" Classes="section-label" Margin="0"/>
                                <TextBlock Grid.Column="1"
                                           x:Name="ProgressPct"
                                           Text="—"
                                           FontSize="8.5" FontWeight="Bold"
                                           Foreground="#686868"/>
                            </Grid>

                            <Grid Grid.Row="6">
                                <Border CornerRadius="3" Height="5"
                                        Background="#080808" BorderBrush="#131313" BorderThickness="1"/>
                                <Border x:Name="ProgressBar"
                                        CornerRadius="3" Height="5"
                                        HorizontalAlignment="Left" Width="0">
                                    <Border.Background>
                                        <LinearGradientBrush StartPoint="0%,50%" EndPoint="100%,50%">
                                            <GradientStop Color="#555555" Offset="0"/>
                                            <GradientStop Color="#C8C8C8" Offset="1"/>
                                        </LinearGradientBrush>
                                    </Border.Background>
                                    <Border.Effect>
                                        <DropShadowEffect Color="#AAAAAA" BlurRadius="7" OffsetX="0" OffsetY="0" Opacity="0.35"/>
                                    </Border.Effect>
                                </Border>
                            </Grid>

                            <Button Grid.Row="8"
                                    x:Name="ActionBtn"
                                    Classes="action-btn"
                                    IsEnabled="False"
                                    Click="ActionBtn_Click"
                                    BorderBrush="#191919">
                                <TextBlock x:Name="ActionBtnText"
                                           Text="SELECT A FILE TO BEGIN"
                                           FontSize="11.5" FontWeight="SemiBold"
                                           Foreground="#3C3C3C"
                                           VerticalAlignment="Center"/>
                            </Button>

                        </Grid>
                    </Border>

                </Grid>

                <TextBlock Grid.Row="2"
                           FontSize="9" Foreground="#2E2E2E"
                           HorizontalAlignment="Center" VerticalAlignment="Center"
                           Text="FPS Method · everything runs locally · no upload · no server"/>

            </Grid>
        </Border>

    </Grid>

</Window>
